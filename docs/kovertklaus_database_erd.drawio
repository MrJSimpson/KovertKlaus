        <!-- Entity 1: User -->
        <mxCell id="ent_user" value="&lt;b style=&quot;color:#38BDF8;font-size:14px;&quot;&gt;User&lt;/b&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-family:monospace;font-size:10px;color:#CBD5E1;&quot;&gt;&lt;b style=&quot;color:#F59E0B;&quot;&gt;PK&lt;/b&gt; id : String (UUID / CUID)&lt;br&gt;&lt;b style=&quot;color:#38BDF8;&quot;&gt;UQ&lt;/b&gt; email : String&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;name : String&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;codename : String?&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;passwordHash : String&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;penaltyPoints : Int (0-4)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;accountStatus : Enum (ACTIVE...)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;isWorkshop : Boolean&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;address : String?&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;createdAt : DateTime&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0284C7;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="280" height="220" as="geometry" />
        </mxCell>

        <!-- Entity 2: Exchange (Mission) -->
        <mxCell id="ent_exchange" value="&lt;b style=&quot;color:#10B981;font-size:14px;&quot;&gt;Exchange (Holiday Mission)&lt;/b&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-family:monospace;font-size:10px;color:#CBD5E1;&quot;&gt;&lt;b style=&quot;color:#F59E0B;&quot;&gt;PK&lt;/b&gt; id : String&lt;br&gt;&lt;b style=&quot;color:#38BDF8;&quot;&gt;UQ&lt;/b&gt; code : String (e.g. KOVERT-87WZ)&lt;br&gt;&lt;b style=&quot;color:#A855F7;&quot;&gt;FK&lt;/b&gt; organizerId : String -&gt; User.id&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;title : String&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;status : Enum (RECRUITING...)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;budgetMin : Decimal?&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;budgetMax : Decimal&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;currency : String (USD)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;inviteCutoffDate : DateTime?&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;assignmentDate : DateTime?&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;shippingDate : DateTime?&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;executionDate : DateTime?&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064E3B;strokeColor=#059669;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="1">
