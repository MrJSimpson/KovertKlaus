        <mxCell id="tpl_card_invite" value="&lt;b style=&quot;color:#F59E0B;&quot;&gt;getInvitationEmailTemplate()&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• Event Title &amp;amp; Organizer Display&lt;br&gt;• Target Budget Range ($25 – $50)&lt;br&gt;• Highlighted Base32 Invite Code Box&lt;br&gt;• Late Pass Emergency Clearance Badge&lt;br&gt;• 1-Click &quot;Accept Mission Directive&quot; CTA&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#451A03;strokeColor=#D97706;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane_templates">
