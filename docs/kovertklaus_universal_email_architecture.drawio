        <mxCell id="lane_templates" value="&lt;b style=&quot;font-size:15px;color:#38BDF8;&quot;&gt;🎨 2. Whimsical Covert Ops Templates&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748B;&quot;&gt;HTML Table Container &amp;amp; Plaintext Fallback (src/lib/email/templates/index.ts)&lt;/span&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0B0F19;strokeColor=#1E293B;fontColor=#F8FAFC;startSize=45;arcSize=8;rounded=1;" vertex="1" parent="1">
