        <mxCell id="trig_clearance" value="&lt;b style=&quot;color:#10B981;&quot;&gt;Early Access Clearance Lead&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#94A3B8;&quot;&gt;POST /api/clearance&lt;/span&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• Rate Limited (5 req/min/IP)&lt;br&gt;• SHA-256 Privacy Hash&lt;br&gt;• Upsert to ClearanceLead table&lt;br&gt;• Triggers &lt;b&gt;sendClearanceConfirmationEmail()&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064E3B;strokeColor=#059669;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane_triggers">
