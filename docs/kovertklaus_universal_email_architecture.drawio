        <!-- ================= LANE 3: DISPATCHER & AUTO-DETECTION ================= -->
        <mxCell id="lane_dispatcher" value="&lt;b style=&quot;font-size:15px;color:#38BDF8;&quot;&gt;⚙️ 3. Universal Dispatcher Strategy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748B;&quot;&gt;Auto-Detection &amp;amp; Route Strategy (src/lib/email/dispatcher.ts)&lt;/span&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0B0F19;strokeColor=#1E293B;fontColor=#F8FAFC;startSize=45;arcSize=8;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="140" width="410" height="1080" as="geometry" />
        </mxCell>

        <mxCell id="disp_core" value="&lt;b style=&quot;font-size:14px;color:#F8FAFC;&quot;&gt;sendEmail(message, configOverride?)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#94A3B8;&quot;&gt;Unified Strategy Router &amp;amp; Error Handler&lt;/span&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• Normalizes To / From / Subject / HTML / Plaintext&lt;br&gt;• Resolves runtime config via &lt;b&gt;getEmailConfig()&lt;/b&gt;&lt;br&gt;• Dispatches through resolved provider adapter&lt;br&gt;• Returns standard &lt;b&gt;EmailResult&lt;/b&gt; { success, provider, messageId, error }&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#38BDF8;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane_dispatcher">
          <mxGeometry x="20" y="60" width="370" height="140" as="geometry" />
        </mxCell>

        <mxCell id="disp_detector" value="&lt;b style=&quot;color:#F59E0B;&quot;&gt;Auto-Detection Priority Resolver (config.ts)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#94A3B8;&quot;&gt;Evaluates process.env settings&lt;/span&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;line-height:1.6;&quot;&gt;&lt;b&gt;EMAIL_PROVIDER:&lt;/b&gt; &apos;auto&apos; (default) | &apos;brevo&apos; | &apos;smtp&apos; | &apos;resend&apos; | &apos;console&apos;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#10B981;&quot;&gt;1. If BREVO_API_KEY is present:&lt;/b&gt;&lt;br&gt;➔ &lt;b&gt;Selects Provider: &apos;brevo&apos;&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#38BDF8;&quot;&gt;2. Else if SMTP_HOST is present:&lt;/b&gt;&lt;br&gt;➔ &lt;b&gt;Selects Provider: &apos;smtp&apos;&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#A855F7;&quot;&gt;3. Else if RESEND_API_KEY is present:&lt;/b&gt;&lt;br&gt;➔ &lt;b&gt;Selects Provider: &apos;resend&apos;&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#94A3B8;&quot;&gt;4. Fallback (No keys configured):&lt;/b&gt;&lt;br&gt;➔ &lt;b&gt;Selects Provider: &apos;console&apos;&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#D97706;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane_dispatcher">
          <mxGeometry x="20" y="240" width="370" height="230" as="geometry" />
        </mxCell>

        <mxCell id="disp_helpers" value="&lt;b style=&quot;color:#38BDF8;&quot;&gt;Convenience Dispatcher Helper Wrappers&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;line-height:1.7;&quot;&gt;• &lt;b&gt;sendInvitationEmail(params)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;sendAssignmentEmail(params)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;sendTargetAssignmentEmail(params)&lt;/b&gt; (Alias)&lt;br&gt;• &lt;b&gt;sendWelcomeEmail(params)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;sendBroadcastEmail(params)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;sendNudgeEmail(params)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;sendClearanceConfirmationEmail(params)&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0284C7;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane_dispatcher">
          <mxGeometry x="20" y="510" width="370" height="190" as="geometry" />
        </mxCell>

        <!-- ================= LANE 4: PROVIDER ADAPTERS ================= -->
        <mxCell id="lane_providers" value="&lt;b style=&quot;font-size:15px;color:#38BDF8;&quot;&gt;🔌 4. Pluggable Provider Adapters&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748B;&quot;&gt;Concrete Adapter Implementations (src/lib/email/providers/*)&lt;/span&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0B0F19;strokeColor=#1E293B;fontColor=#F8FAFC;startSize=45;arcSize=8;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1260" y="140" width="400" height="1080" as="geometry" />
        </mxCell>

        <mxCell id="prov_brevo" value="&lt;b style=&quot;color:#10B981;font-size:13px;&quot;&gt;A. Brevo REST API Adapter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#94A3B8;&quot;&gt;src/lib/email/providers/brevo.ts&lt;/span&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• &lt;b&gt;Target Endpoint:&lt;/b&gt; POST https://api.brevo.com/v3/smtp/email&lt;br&gt;• &lt;b&gt;Egress:&lt;/b&gt; Pure native &lt;b&gt;fetch()&lt;/b&gt; — ZERO npm dependencies&lt;br&gt;• &lt;b&gt;Auth:&lt;/b&gt; api-key: ${BREVO_API_KEY}&lt;br&gt;• &lt;b&gt;Account:&lt;/b&gt; 300 daily emails free tier for &lt;b&gt;admin@kovertklaus.com&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Runtime:&lt;/b&gt; 100% Cloudflare Worker, Edge &amp;amp; Node.js safe&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064E3B;strokeColor=#059669;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane_providers">
          <mxGeometry x="20" y="60" width="360" height="170" as="geometry" />
        </mxCell>

        <mxCell id="prov_smtp" value="&lt;b style=&quot;color:#38BDF8;font-size:13px;&quot;&gt;B. Direct SMTP Adapter (Nodemailer)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#94A3B8;&quot;&gt;src/lib/email/providers/smtp.ts&lt;/span&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• &lt;b&gt;Target:&lt;/b&gt; Custom Mail Server / Local Postfix / ISP SMTP&lt;br&gt;• &lt;b&gt;Transport:&lt;/b&gt; Standard SMTP over TCP sockets (Ports 587, 465, 25)&lt;br&gt;• &lt;b&gt;Isolation:&lt;/b&gt; Dynamic runtime import &lt;b&gt;await import(&apos;nodemailer&apos;)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Safety:&lt;/b&gt; Prevents bundling overhead and edge runtime crashes&lt;br&gt;• &lt;b&gt;Ideal For:&lt;/b&gt; Self-hosted home users, Docker, and private VPS&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0284C7;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane_providers">
          <mxGeometry x="20" y="270" width="360" height="170" as="geometry" />
        </mxCell>

        <mxCell id="prov_resend" value="&lt;b style=&quot;color:#A855F7;font-size:13px;&quot;&gt;C. Resend REST API Adapter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#94A3B8;&quot;&gt;src/lib/email/providers/resend.ts&lt;/span&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• &lt;b&gt;Target Endpoint:&lt;/b&gt; POST https://api.resend.com/emails&lt;br&gt;• &lt;b&gt;Auth:&lt;/b&gt; Authorization: Bearer ${RESEND_API_KEY}&lt;br&gt;• &lt;b&gt;Egress:&lt;/b&gt; Pure native &lt;b&gt;fetch()&lt;/b&gt; — Zero dependencies&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3B0764;strokeColor=#9333EA;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane_providers">
          <mxGeometry x="20" y="480" width="360" height="130" as="geometry" />
        </mxCell>

        <mxCell id="prov_console" value="&lt;b style=&quot;color:#F59E0B;font-size:13px;&quot;&gt;D. Console Sandbox Mock Simulator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#94A3B8;&quot;&gt;src/lib/email/providers/console.ts&lt;/span&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• &lt;b&gt;Target:&lt;/b&gt; Terminal stdout / Node.js console logs&lt;br&gt;• &lt;b&gt;Output:&lt;/b&gt; Formatted ASCII banner with To, Subject &amp;amp; Code&lt;br&gt;• &lt;b&gt;Zero-Crash Policy:&lt;/b&gt; Allows local testing without email keys&lt;br&gt;• &lt;b&gt;Returns:&lt;/b&gt; { success: true, provider: &apos;console&apos;, messageId: mock-id }&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#451A03;strokeColor=#D97706;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane_providers">
          <mxGeometry x="20" y="650" width="360" height="160" as="geometry" />
        </mxCell>

        <!-- ================= LANE 5: EGRESS & RECIPIENTS ================= -->
        <mxCell id="lane_egress" value="&lt;b style=&quot;font-size:15px;color:#38BDF8;&quot;&gt;🌐 5. Network Egress &amp;amp; Inboxes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748B;&quot;&gt;Delivery Infrastructure &amp;amp; User Touchpoints&lt;/span&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0B0F19;strokeColor=#1E293B;fontColor=#F8FAFC;startSize=45;arcSize=8;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1690" y="140" width="370" height="1080" as="geometry" />
        </mxCell>

        <mxCell id="egress_brevo_cloud" value="&lt;b style=&quot;color:#10B981;&quot;&gt;Brevo Global SMTP Cluster&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#94A3B8;&quot;&gt;smtp-relay.brevo.com / API Gateway&lt;/span&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• High Deliverability Infrastructure&lt;br&gt;• Automated DKIM / SPF Signing&lt;br&gt;• 300 free transactions / day pool&lt;br&gt;• Real-Time Dispatch Status Webhooks&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064E3B;strokeColor=#059669;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane_egress">
          <mxGeometry x="20" y="60" width="330" height="140" as="geometry" />
        </mxCell>

        <mxCell id="egress_cf_dns" value="&lt;b style=&quot;color:#38BDF8;&quot;&gt;kovertklaus.com DNS &amp;amp; Deliverability&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#94A3B8;&quot;&gt;Cloudflare DNS Management&lt;/span&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• &lt;b&gt;Sender:&lt;/b&gt; admin@kovertklaus.com&lt;br&gt;• &lt;b&gt;SPF:&lt;/b&gt; v=spf1 include:spf.brevo.com ~all&lt;br&gt;• &lt;b&gt;DKIM:&lt;/b&gt; k1._domainkey.kovertklaus.com&lt;br&gt;• &lt;b&gt;DMARC:&lt;/b&gt; v=DMARC1; p=none; rua=...&lt;br&gt;• &lt;b&gt;Inbound:&lt;/b&gt; Cloudflare Email Routing Forwarding&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0284C7;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane_egress">
          <mxGeometry x="20" y="240" width="330" height="160" as="geometry" />
        </mxCell>

        <mxCell id="egress_smtp_server" value="&lt;b style=&quot;color:#38BDF8;&quot;&gt;Self-Hosted / Home Lab Mail Server&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#94A3B8;&quot;&gt;Local Network or VPS Postfix&lt;/span&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• Local SMTP Relay over TLS 587/465&lt;br&gt;• Full Self-Hosting Data Sovereignty&lt;br&gt;• Independent from 3rd party API limits&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#38BDF8;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane_egress">
          <mxGeometry x="20" y="440" width="330" height="130" as="geometry" />
        </mxCell>

        <mxCell id="egress_inbox" value="&lt;b style=&quot;color:#10B981;&quot;&gt;Operative Inboxes (Recipients)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#94A3B8;&quot;&gt;Gmail, Apple Mail, Outlook, Mobile Devices&lt;/span&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• ✉️ Early-Access Clearance Ciphers&lt;br&gt;• ✉️ Welcome Onboarding Directives&lt;br&gt;• ✉️ Exchange Recruitment Orders &amp;amp; Late Passes&lt;br&gt;• ✉️ Secret Sattolo Target Dossiers&lt;br&gt;• ✉️ OpsLeader Urgent Reminder Nudges&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064E3B;strokeColor=#059669;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane_egress">
          <mxGeometry x="20" y="610" width="330" height="160" as="geometry" />
