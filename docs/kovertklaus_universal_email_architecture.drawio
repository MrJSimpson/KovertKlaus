        <mxCell id="tpl_engine" value="&lt;b style=&quot;font-size:13px;color:#38BDF8;&quot;&gt;renderBaseEmail() Layout Engine&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• &lt;b&gt;Design Tokens:&lt;/b&gt; Midnight Slate (&lt;font color=&quot;#090D16&quot;&gt;#090D16&lt;/font&gt;), Emerald (&lt;font color=&quot;#10B981&quot;&gt;#10B981&lt;/font&gt;), Gold (&lt;font color=&quot;#F59E0B&quot;&gt;#F59E0B&lt;/font&gt;), Sky (&lt;font color=&quot;#38BDF8&quot;&gt;#38BDF8&lt;/font&gt;)&lt;br&gt;• &lt;b&gt;Header Banner:&lt;/b&gt; 🎄 KOVERT KLAUS 🕶️ — Classified Operation Network&lt;br&gt;• &lt;b&gt;Compatibility:&lt;/b&gt; Strict HTML table layout (Apple Mail, Gmail, Outlook, Thunderbird)&lt;br&gt;• &lt;b&gt;Plaintext Generator:&lt;/b&gt; stripHtml() regex fallback ensuring 100% readability on CLI/smartwatches&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0284C7;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane_templates">
