        <mxCell id="tpl_broadcast" value="&lt;b style=&quot;color:#A855F7;&quot;&gt;sendBroadcastEmail()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#94A3B8;&quot;&gt;Subject: 📢 [{title}] Message from Head Elf {sender}&lt;/span&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• Custom OpsLeader Announcement&lt;br&gt;• Formatted Multi-Line Dispatch Body&lt;br&gt;• 1-Click Command Center Link&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3B0764;strokeColor=#9333EA;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane4">
          <mxGeometry x="20" y="690" width="330" height="110" as="geometry" />
