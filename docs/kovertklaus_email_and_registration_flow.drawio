        <mxCell id="db_leads" value="&lt;b style=&quot;color:#10B981;&quot;&gt;model ClearanceLead&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;&lt;b&gt;id:&lt;/b&gt; String @id @default(uuid())&lt;br&gt;&lt;b&gt;email:&lt;/b&gt; String @unique&lt;br&gt;&lt;b&gt;name:&lt;/b&gt; String?&lt;br&gt;&lt;b&gt;ipHash:&lt;/b&gt; String?&lt;br&gt;&lt;b&gt;source:&lt;/b&gt; String (&quot;landing_waitlist&quot;)&lt;br&gt;&lt;b&gt;status:&lt;/b&gt; String (&quot;PENDING&quot;)&lt;br&gt;&lt;b&gt;createdAt / updatedAt:&lt;/b&gt; DateTime&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#059669;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane3">
          <mxGeometry x="20" y="60" width="290" height="130" as="geometry" />
        </mxCell>

        <mxCell id="db_users" value="&lt;b style=&quot;color:#38BDF8;&quot;&gt;model User&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;&lt;b&gt;id:&lt;/b&gt; String @id @default(uuid())&lt;br&gt;&lt;b&gt;email:&lt;/b&gt; String @unique&lt;br&gt;&lt;b&gt;name / codename:&lt;/b&gt; String&lt;br&gt;&lt;b&gt;passwordHash:&lt;/b&gt; String&lt;br&gt;&lt;b&gt;penaltyPoints:&lt;/b&gt; Int @default(0)&lt;br&gt;&lt;b&gt;accountStatus:&lt;/b&gt; ACTIVE / RESTRICTED&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0284C7;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane3">
          <mxGeometry x="20" y="220" width="290" height="130" as="geometry" />
