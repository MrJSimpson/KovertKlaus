        <!-- Title Banner -->
        <mxCell id="title" value="&lt;b style=&quot;font-size:22px;color:#F8FAFC;&quot;&gt;🎁 KovertKlaus — Email Infrastructure &amp;amp; SaaS Registration Flow&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#94A3B8;font-family:monospace;&quot;&gt;End-to-End Clearance Leads, Transactional Dispatch, Cloudflare Email Routing &amp;amp; DNS Deliverability&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#334155;arcSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
