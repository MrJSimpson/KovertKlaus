        <mxCell id="cf_inbound" value="&lt;b style=&quot;color:#F59E0B;&quot;&gt;Cloudflare Email Routing (Inbound)&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• dispatch@kovertklaus.com ➔ Personal Inbox&lt;br&gt;• hq@kovertklaus.com ➔ Personal Inbox&lt;br&gt;• support@kovertklaus.com ➔ Personal Inbox&lt;br&gt;• Catch-All: *@kovertklaus.com Forwarding&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#451A03;strokeColor=#D97706;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane5">
