        <mxCell id="tpl_welcome" value="&lt;b style=&quot;color:#38BDF8;&quot;&gt;sendWelcomeEmail()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#94A3B8;&quot;&gt;Subject: 🕶️ Welcome to KovertKlaus, Agent {codename}!&lt;/span&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• Operative Profile Overview&lt;br&gt;• OpKit Wishlist Setup Checklist&lt;br&gt;• Sizing &amp;amp; Preferences Instructions&lt;br&gt;• 1-Click Dashboard Access Link&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0284C7;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane4">
