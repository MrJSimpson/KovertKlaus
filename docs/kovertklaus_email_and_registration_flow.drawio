        <mxCell id="tpl_invite" value="&lt;b style=&quot;color:#F59E0B;&quot;&gt;sendInvitationEmail()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#94A3B8;&quot;&gt;Subject: 🎅 Classified Invitation: You&apos;re Recruited for &quot;{title}&quot;&lt;/span&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• Head Elf Organizer Name&lt;br&gt;• Gift Budget Range ($25 – $50)&lt;br&gt;• Base32 Operation Code (XXXX-YYYY)&lt;br&gt;• 🎁 Accept Mission &amp;amp; Join Button&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#451A03;strokeColor=#D97706;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane4">
