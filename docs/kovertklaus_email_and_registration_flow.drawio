        <mxCell id="tpl_clearance" value="&lt;b style=&quot;color:#10B981;&quot;&gt;sendClearanceConfirmationEmail()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#94A3B8;&quot;&gt;Subject: 🎄 [KovertKlaus HQ] Clearance Access Request Acknowledged&lt;/span&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• Classified Operative Status Badge&lt;br&gt;• Priority Clearance Confirmation&lt;br&gt;• Nov 1 Target Launch Roadmap Dates&lt;br&gt;• 100% Free Self-Host Guarantee&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064E3B;strokeColor=#059669;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane4">
