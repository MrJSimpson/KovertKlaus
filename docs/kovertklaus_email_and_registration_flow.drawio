        <mxCell id="ui_waitlist" value="&lt;b style=&quot;color:#10B981;&quot;&gt;Early Access Clearance Form&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#94A3B8;&quot;&gt;ComingSoonLanding.tsx&lt;/span&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• Email Input &amp;amp; Sanitization&lt;br&gt;• Async State Machine (loading, error)&lt;br&gt;• Transmitting... Spinner&lt;br&gt;• Classified Success Banner&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064E3B;strokeColor=#059669;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane1">
          <mxGeometry x="20" y="60" width="300" height="120" as="geometry" />
