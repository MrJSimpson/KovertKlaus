        <mxCell id="db_exchange" value="&lt;b style=&quot;color:#F59E0B;&quot;&gt;model Exchange &amp;amp; Member&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;&lt;b&gt;Exchange:&lt;/b&gt; code, title, dates, budget&lt;br&gt;&lt;b&gt;ExchangeMember:&lt;/b&gt;&lt;br&gt;• userId &amp;amp; exchangeId&lt;br&gt;• role: ORGANIZER / MEMBER&lt;br&gt;• targetUserId: String?&lt;br&gt;• shippingStatus: PENDING / SHIPPED&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#D97706;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane3">
