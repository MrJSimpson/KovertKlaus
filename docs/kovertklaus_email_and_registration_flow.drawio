        <!-- ================= LANE 1: FRONTEND UI ================= -->
        <mxCell id="lane1" value="&lt;b style=&quot;font-size:15px;color:#38BDF8;&quot;&gt;🖥️ 1. Frontend UI &amp;amp; Client Touchpoints&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748B;&quot;&gt;kovertklaus.com (Cloudflare / Next.js)&lt;/span&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#090D16;strokeColor=#1E293B;fontColor=#F8FAFC;startSize=45;arcSize=8;rounded=1;" vertex="1" parent="1">
