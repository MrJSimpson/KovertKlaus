        <mxCell id="ui_broadcast" value="&lt;b style=&quot;color:#A855F7;&quot;&gt;OpTeam Broadcast &amp;amp; Nudge Modal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#94A3B8;&quot;&gt;OpTeamBroadcastModal.tsx&lt;/span&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• Custom Head Elf Announcement&lt;br&gt;• Shipping Deadline Countdown Alert&lt;br&gt;• All-Operative Stream Push&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3B0764;strokeColor=#9333EA;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane1">
