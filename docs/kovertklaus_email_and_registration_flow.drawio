        <!-- ================= LANE 2: API ROUTE HANDLERS ================= -->
        <mxCell id="lane2" value="&lt;b style=&quot;font-size:15px;color:#38BDF8;&quot;&gt;⚡ 2. API Route Handlers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748B;&quot;&gt;Next.js App Router (/src/app/api/*)&lt;/span&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#090D16;strokeColor=#1E293B;fontColor=#F8FAFC;startSize=45;arcSize=8;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="120" width="330" height="980" as="geometry" />
        </mxCell>

        <mxCell id="api_leads" value="&lt;b style=&quot;color:#10B981;&quot;&gt;POST /api/clearance &amp;amp; /api/leads&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• Rate Limiter (5 req/min per IP)&lt;br&gt;• SHA-256 IP Salt Hashing&lt;br&gt;• isValidEmail() RFC Validation&lt;br&gt;• Idempotent Lead Upsert&lt;br&gt;• Async Email Dispatch Trigger&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#059669;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane2">
          <mxGeometry x="20" y="60" width="290" height="120" as="geometry" />
        </mxCell>

        <mxCell id="api_users" value="&lt;b style=&quot;color:#38BDF8;&quot;&gt;POST /api/users&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• Password Complexity Rule&lt;br&gt;• Bcrypt Salt Rounds = 12&lt;br&gt;• HTTP-Only Session Cookie&lt;br&gt;• Auto-Init Master OpKit&lt;br&gt;• Onboarding Welcome Dispatch&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0284C7;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane2">
          <mxGeometry x="20" y="220" width="290" height="120" as="geometry" />
        </mxCell>

        <mxCell id="api_invitations" value="&lt;b style=&quot;color:#F59E0B;&quot;&gt;POST /api/invitations&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• Organizer Authority Check&lt;br&gt;• Duplicate Enrollment Guard&lt;br&gt;• Cutoff Date Policy Enforcement&lt;br&gt;• Generate Token INV-XXXX&lt;br&gt;• Dispatches Invitation Email&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#D97706;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane2">
          <mxGeometry x="20" y="380" width="290" height="120" as="geometry" />
        </mxCell>

        <mxCell id="api_operations" value="&lt;b style=&quot;color:#EC4899;&quot;&gt;POST /api/operations (Draw)&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• action: &apos;draw&apos; Handler&lt;br&gt;• Sattolo Derangement Execution&lt;br&gt;• Sets targetUserId in DB&lt;br&gt;• Dispatches Target Alerts&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#DB2777;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane2">
          <mxGeometry x="20" y="540" width="290" height="120" as="geometry" />
        </mxCell>

        <mxCell id="api_broadcast" value="&lt;b style=&quot;color:#A855F7;&quot;&gt;POST /api/operations (Broadcast)&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• action: &apos;sendOpTeamBroadcast&apos;&lt;br&gt;• Enrolled Agent Roster Query&lt;br&gt;• In-App Notifications Created&lt;br&gt;• Dispatches Broadcast Emails&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#9333EA;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane2">
          <mxGeometry x="20" y="700" width="290" height="110" as="geometry" />
