        <!-- ================= LANE 3: DATA PERSISTENCE ================= -->
        <mxCell id="lane3" value="&lt;b style=&quot;font-size:15px;color:#38BDF8;&quot;&gt;🗄️ 3. Database Persistence&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748B;&quot;&gt;Prisma ORM &amp;amp; PostgreSQL DB&lt;/span&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#090D16;strokeColor=#1E293B;fontColor=#F8FAFC;startSize=45;arcSize=8;rounded=1;" vertex="1" parent="1">
