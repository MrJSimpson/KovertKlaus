        <mxCell id="ui_register" value="&lt;b style=&quot;color:#38BDF8;&quot;&gt;Agent Sign Up / Registration Modal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#94A3B8;&quot;&gt;AppHomeLanding.tsx / page.tsx&lt;/span&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#334155;&quot;&gt;&lt;div style=&quot;text-align:left;font-size:10px;color:#CBD5E1;&quot;&gt;• Full Name &amp;amp; Codename&lt;br&gt;• 10-Char Complex Password&lt;br&gt;• OpKit Wishlist Auto-Init&lt;br&gt;• Direct Session Token Storage&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0284C7;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="lane1">
