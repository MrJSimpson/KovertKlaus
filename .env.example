# -----------------------------------------------------------------------------
# 🎁 KovertKlaus™ Minimalist Environment Configuration
# -----------------------------------------------------------------------------
# NOTE: All application options, themes, seasonal rotations, email dispatchers
# (Brevo, SMTP, Resend), public quotas, and maintenance modes are administered 
# directly in the database via the /northpole Command Center web UI.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# 🚀 System Mode & Initialization Vector ("SELFHOSTED" | "SAAS")
# -----------------------------------------------------------------------------
# MODE: Startup initialization vector. Default is "SELFHOSTED".
# - "SELFHOSTED": Activates flexible local configuration and auto-bootstraps
#   the initial 'santa' administrator with NIST first-time reset requirement.
# - "SAAS": Bypasses self-hosted bootstrap vectors and enables multi-tenant
#   cloud SaaS feature modules (billing, waitlists, multi-tenancy quotas).
MODE="SELFHOSTED"


# -----------------------------------------------------------------------------
# 🗄️ PostgreSQL Database Connections (Neon / Supabase / Local Docker)
# -----------------------------------------------------------------------------
# DATABASE_URL: Pooled connection string for runtime application & serverless execution
DATABASE_URL="postgresql://kovert:kovertsecret@localhost:5432/kovertklaus?schema=public"

# DIRECT_URL: Direct unpooled connection string for Prisma CLI schema migrations
DIRECT_URL="postgresql://kovert:kovertsecret@localhost:5432/kovertklaus?schema=public"

# -----------------------------------------------------------------------------
# 🔐 Security & Session Secrets
# -----------------------------------------------------------------------------
SESSION_SECRET="your-classified-secret-here"
NEXTAUTH_SECRET="your-classified-secret-here"

# -----------------------------------------------------------------------------
# 🎅 Initial North Pole Admin Bootstrap (Optional)
# Auto-seeds the primary Super Admin if the AdminUser table is empty on first launch.
# NOTE: Password MUST be reset on initial login per NIST SP 800-63B guidelines.
# -----------------------------------------------------------------------------
INITIAL_ADMIN_USERNAME="santa"
INITIAL_ADMIN_EMAIL="admin@kovertklaus.com"
INITIAL_ADMIN_PASSWORD="1sEcReTdEl!vErY"
