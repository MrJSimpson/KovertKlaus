datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum AccountStatus {
  ACTIVE
  REMOTE_RESTRICTED
  DISABLED
}

enum ExchangeStatus {
  SETUP
  RECRUITING
  MATCHED
  SHIPPED
  EXECUTED
  COMPLETED
}

enum GiftingType {
  SINGLE
  MULTIPLE
}

enum PaymentStatus {
  FREE_ANNUAL
  PAID
  EXEMPT_SELF_HOSTED
}

enum MemberRole {
  ORGANIZER
  MEMBER
}

enum ShippingStatus {
  PENDING
  LOCAL_DELIVERY
  SHIPPED
}

enum WishlistType {
  STANDARD
  WHITE_ELEPHANT
}

model User {
  id                             String            @id @default(uuid())
  email                          String            @unique
  name                           String
  codename                       String?
  passwordHash                   String
  streetAddress                  String?
  addressLine2                   String?
  city                           String?
  state                          String?
  zipCode                        String?
  country                        String?           @default("US")
  deliveryNotes                  String?
  shirtSize                      String?
  topHalfSize                    String?
  bottomHalfSize                 String?
  shoeSize                       String?
  chestBustMeasurement           String?
  waistMeasurement               String?
  inseamMeasurement              String?
  favoriteColors                 String?
  allergiesDiet                  String?
  dislikes                       String?
  favoriteHobbies                String?
  allowOrganizerViewSizes        Boolean           @default(true)
  allowOrganizerViewMeasurements Boolean           @default(false)
  allowOrganizerViewAllergies    Boolean           @default(true)
  allowOrganizerViewFavorites    Boolean           @default(false)
  penaltyPoints                  Int               @default(0)
  accountStatus                  AccountStatus     @default(ACTIVE)
  isWorkshop                     Boolean           @default(false)
  emailNotifications             Boolean           @default(true)
  createdAt                      DateTime          @default(now())
  updatedAt                      DateTime          @updatedAt

  createdExchanges       Exchange[]        @relation("OrganizerExchanges")
  participations         ExchangeMember[]  @relation("MemberUser")
  targetedBy             ExchangeMember[]  @relation("TargetUser")
  items                  Item[]
  wishlists              Wishlist[]
  notifications          Notification[]
  exclusionRulesAsMember ExclusionRule[]   @relation("ExclusionMember")
  exclusionRulesAsTarget ExclusionRule[]   @relation("ExclusionRestrictedMember")
  sentMessages           ExchangeMessage[] @relation("MessageSender")
  receivedMessages       ExchangeMessage[] @relation("MessageRecipient")
  exchangeReports        ExchangeReport[]
}

model Exchange {
  id                    String         @id @default(uuid())
  title                 String
  description           String?
  code                  String         @unique
  organizerId           String
  organizer             User           @relation("OrganizerExchanges", fields: [organizerId], references: [id])
  maxParticipants       Int?
  giftingType           GiftingType    @default(SINGLE)
  isLocalOnly           Boolean        @default(false)
  eventLocation         String?
  isWhiteElephant       Boolean        @default(false)
  organizerAssistedDraw Boolean        @default(true)
  drawVerifiedAt        DateTime?
  budgetMin             Decimal?       @db.Decimal(10, 2)
  budgetMax             Decimal        @db.Decimal(10, 2)
  currency              String         @default("USD")
  inviteCutoffDate      DateTime
  assignmentDate        DateTime
  shippingDate          DateTime?
  executionDate         DateTime
  status                ExchangeStatus @default(RECRUITING)
  isFreeAnnualExchange  Boolean        @default(false)
  enforcePenalties      Boolean        @default(true)
  paymentStatus         PaymentStatus  @default(FREE_ANNUAL)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  members        ExchangeMember[]
  exclusionRules ExclusionRule[]
  messages       ExchangeMessage[]
  reports        ExchangeReport[]
}

model ProductCatalog {
  id           String   @id @default(uuid())
  url          String   @unique
  title        String
  price        Decimal  @db.Decimal(10, 2)
  description  String?
  thumbnailUrl String?
  domain       String?
  properties   Json?
  scrapedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items Item[]
}

model Item {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogId    String?
  catalog      ProductCatalog? @relation(fields: [catalogId], references: [id], onDelete: SetNull)
  name         String
  url          String
  price        Decimal         @db.Decimal(10, 2)
  description  String?
  thumbnailUrl String?
  properties   Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  wishlistItems WishlistItem[]
}

model Wishlist {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      WishlistType @default(STANDARD)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  wishlistItems   WishlistItem[]
  exchangeMembers ExchangeMember[]
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  itemId     String
  quantity   Int      @default(1)
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, itemId])
}

model ExchangeMember {
  id                 String         @id @default(uuid())
  exchangeId         String
  userId             String
  wishlistId         String?
  role               MemberRole     @default(MEMBER)
  targetUserId       String?
  shippingStatus     ShippingStatus @default(PENDING)
  trackingNumber     String?
  shippedAt          DateTime?
  deliveredConfirmed Boolean        @default(false)
  joinedAt           DateTime       @default(now())

  exchange Exchange  @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  user     User      @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  targetUser User?   @relation("TargetUser", fields: [targetUserId], references: [id])
  wishlist Wishlist? @relation(fields: [wishlistId], references: [id])

  @@unique([exchangeId, userId])
}

model ExclusionRule {
  id                 String @id @default(uuid())
  exchangeId         String
  memberId           String
  restrictedMemberId String

  exchange         Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  member           User     @relation("ExclusionMember", fields: [memberId], references: [id], onDelete: Cascade)
  restrictedMember User     @relation("ExclusionRestrictedMember", fields: [restrictedMemberId], references: [id], onDelete: Cascade)

  @@unique([exchangeId, memberId, restrictedMemberId])
}

model ExchangeMessage {
  id          String   @id @default(uuid())
  exchangeId  String
  senderId    String
  recipientId String
  messageText String
  isFromSanta Boolean  @default(true)
  createdAt   DateTime @default(now())

  exchange  Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  sender    User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
}

model Notification {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  message        String
  exchangeId     String?
  isAcknowledged Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model ExchangeReport {
  id           String   @id @default(uuid())
  exchangeId   String
  userId       String
  thankYouText String?
  photoUrl     String?
  createdAt    DateTime @default(now())

  exchange Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ClearanceLead {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  ipHash    String?
  source    String   @default("landing_waitlist")
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id                    String    @id @default(uuid())
  email                 String    @unique
  username              String?   @unique
  name                  String
  passwordHash          String
  role                  String    @default("SUPER_ADMIN") // "SUPER_ADMIN" | "OPS_ADMIN" | "MODERATOR"
  isActive              Boolean   @default(true)
  requiresPasswordReset Boolean   @default(false)
  lastLoginAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model ThemePreset {
  id               String   @id // e.g. "winter_holiday", "spring_egg_hunt", "tropic_klaus", "spooky_autumn"
  name             String   // Display Name e.g. "Winter Holiday (Klaus & Kovert)"
  season           String   @default("winter") // "winter" | "spring" | "summer" | "autumn" | "universal"
  isDefault        Boolean  @default(false)
  altHomeKey       String?  @default("coming_soon") // Linked ALT_HOME component key
  
  // Seasonal Themed Banner Text
  bannerTextLight  String?  @default("🎄 Welcome to KovertKlaus! Organize gift exchanges in under 60 seconds.")
  bannerTextDark   String?  @default("❄️ Winter Night Ops Active — Covert Holiday Gifting")
  
  // Visual Strand Style
  lightsStrandType String   @default("christmas_bulbs") // "christmas_bulbs" | "easter_eggs" | "tropic_lanterns" | "spooky_pumpkins" | "none"
  
  // Dual Design System Token Overrides (JSON Objects)
  lightTokens      Json?    // CSS classes for Light Mode (pageBg, headerBg, btnPrimary, badgeCode, etc.)
  darkTokens       Json?    // CSS classes for Dark Mode
  
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  systemConfigs    SystemConfig[]
}

model SystemConfig {
  id                       String       @id @default("singleton")
  activeThemeId            String       @default("winter_holiday")
  activeTheme              ThemePreset  @relation(fields: [activeThemeId], references: [id])
  activeSeason             String       @default("auto") // "auto" | "winter" | "spring" | "summer" | "autumn"
  announcementBannerActive Boolean      @default(true)
  maintenanceMode          Boolean      @default(false)
  maintenanceMessage       String?
  
  // Dynamic App & Routing Options (administered via /northpole)
  altHome                  String?      @default("")
  appMode                  String       @default("selfhosted") // "selfhosted" | "saas"
  
  // Universal Transactional Email Settings (administered via /northpole)
  emailProvider            String       @default("auto") // "auto" | "brevo" | "smtp" | "resend" | "console"
  emailFrom                String       @default("admin@kovertklaus.com")
  emailFromName            String       @default("KovertKlaus HQ")
  brevoApiKey              String?
  brevoSenderEmail         String?
  brevoSenderName          String?
  smtpHost                 String?
  smtpPort                 Int?         @default(587)
  smtpUser                 String?
  smtpPass                 String?
  smtpSecure               Boolean      @default(false)
  smtpFrom                 String?
  resendApiKey             String?
  
  // Public Limits & Quotas
  freeAnnualHostAllowance  Int          @default(1)
  freeAnnualJoinAllowance  Int          @default(3)
  paidEventPriceUsd        Decimal      @default(5.00) @db.Decimal(10, 2)
  maxFreeParticipants      Int          @default(25)
  maxWishlistItems         Int          @default(50)
  defaultBudgetMin         Decimal      @default(0.00) @db.Decimal(10, 2)
  defaultBudgetMax         Decimal      @default(50.00) @db.Decimal(10, 2)
  defaultCurrency          String       @default("USD")
  
  updatedAt                DateTime     @updatedAt
  updatedByAdminId         String?
}
