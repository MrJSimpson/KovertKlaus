datasource db {
  provider = "postgresql"
  schemas  = ["app", "admin"]
}

generator client {
  provider = "prisma-client-js"
}

enum AccountStatus {
  ACTIVE
  REMOTE_RESTRICTED
  DISABLED

  @@schema("app")
}

enum ExchangeStatus {
  SETUP
  RECRUITING
  MATCHED
  SHIPPED
  EXECUTED
  COMPLETED

  @@schema("app")
}

enum GiftingType {
  SINGLE
  MULTIPLE

  @@schema("app")
}

enum PaymentStatus {
  FREE_ANNUAL
  PAID
  EXEMPT_SELF_HOSTED

  @@schema("app")
}

enum MemberRole {
  ORGANIZER
  MEMBER

  @@schema("app")
}

enum ShippingStatus {
  PENDING
  LOCAL_DELIVERY
  SHIPPED

  @@schema("app")
}

enum WishlistType {
  STANDARD
  WHITE_ELEPHANT

  @@schema("app")
}

enum LogLevel {
  ERROR
  WARN
  INFO
  DEBUG

  @@schema("admin")
}

model User {
  id                             String        @id @default(uuid())
  email                          String        @unique
  name                           String
  passwordHash                   String
  /// User session tokens issued before this instant are rejected (set on password change).
  sessionsRevokedAt              DateTime?
  streetAddress                  String?
  addressLine2                   String?
  city                           String?
  state                          String?
  zipCode                        String?
  country                        String?       @default("US")
  deliveryNotes                  String?
  shirtSize                      String?
  topHalfSize                    String?
  bottomHalfSize                 String?
  shoeSize                       String?
  chestBustMeasurement           String?
  waistMeasurement               String?
  inseamMeasurement              String?
  favoriteColors                 String?
  allergiesDiet                  String?
  dislikes                       String?
  favoriteHobbies                String?
  allowOrganizerViewSizes        Boolean       @default(true)
  allowOrganizerViewMeasurements Boolean       @default(false)
  allowOrganizerViewAllergies    Boolean       @default(true)
  allowOrganizerViewFavorites    Boolean       @default(false)
  penaltyPoints                  Int           @default(0)
  accountStatus                  AccountStatus @default(ACTIVE)
  isWorkshop                     Boolean       @default(false)
  emailNotifications             Boolean       @default(true)
  createdAt                      DateTime      @default(now())
  updatedAt                      DateTime      @updatedAt

  createdExchanges       Exchange[]          @relation("OrganizerExchanges")
  participations         ExchangeMember[]    @relation("MemberUser")
  targetedBy             ExchangeMember[]    @relation("TargetUser")
  items                  Item[]
  wishlists              Wishlist[]
  notifications          Notification[]
  exclusionRulesAsMember ExclusionRule[]     @relation("ExclusionMember")
  exclusionRulesAsTarget ExclusionRule[]     @relation("ExclusionRestrictedMember")
  sentMessages           ExchangeMessage[]   @relation("MessageSender")
  invitationsSent        MissionInvitation[] @relation("InvitationsSent")
  receivedMessages       ExchangeMessage[]   @relation("MessageRecipient")
  exchangeReports        ExchangeReport[]

  @@schema("app")
}

model Exchange {
  id                      String         @id @default(uuid())
  title                   String
  description             String?
  code                    String         @unique
  organizerId             String
  organizer               User           @relation("OrganizerExchanges", fields: [organizerId], references: [id])
  maxParticipants         Int?
  giftingType             GiftingType    @default(SINGLE)
  isLocalOnly             Boolean        @default(false)
  eventLocation           String?
  isWhiteElephant         Boolean        @default(false)
  organizerAssistedDraw   Boolean        @default(true)
  drawVerifiedAt          DateTime?
  budgetMin               Decimal?       @db.Decimal(10, 2)
  budgetMax               Decimal        @db.Decimal(10, 2)
  currency                String         @default("USD")
  inviteCutoffDate        DateTime
  assignmentDate          DateTime
  shippingDate            DateTime?
  executionDate           DateTime
  status                  ExchangeStatus @default(RECRUITING)
  /// When the mission was marked COMPLETED. Mission-wide Intel stays readable for 14 days after.
  completedAt             DateTime?
  isFreeAnnualExchange    Boolean        @default(false)
  enforcePenalties        Boolean        @default(true)
  /// When false, an agent's Wishlist Manifest may not total more than `budgetMax`. Each item is always capped at `budgetMax`.
  allowWishlistOverBudget Boolean        @default(true)
  isCovertDelivery        Boolean        @default(false)
  propertyWaiverText      String?
  paymentStatus           PaymentStatus  @default(FREE_ANNUAL)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  members            ExchangeMember[]
  exclusionRules     ExclusionRule[]
  messages           ExchangeMessage[]
  reports            ExchangeReport[]
  covertInviteTokens CovertInviteToken[]
  invitations        MissionInvitation[]

  @@index([organizerId])
  @@index([status])
  @@index([code])
  @@schema("app")
}

model ProductCatalog {
  id           String   @id @default(uuid())
  url          String   @unique
  title        String
  price        Decimal  @db.Decimal(10, 2)
  description  String?
  thumbnailUrl String?
  domain       String?
  properties   Json?
  scrapedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items Item[]

  @@schema("app")
}

model Item {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogId    String?
  catalog      ProductCatalog? @relation(fields: [catalogId], references: [id], onDelete: SetNull)
  name         String
  url          String
  price        Decimal         @db.Decimal(10, 2)
  description  String?
  thumbnailUrl String?
  properties   Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  wishlistItems WishlistItem[]

  @@index([userId])
  @@index([catalogId])
  @@schema("app")
}

/// One agent's Wishlist Manifest for one Holiday Mission. Created with the membership and deleted with it.
model Wishlist {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The mission membership this list belongs to (one list per member per mission).
  memberId  String         @unique
  member    ExchangeMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name      String
  type      WishlistType   @default(STANDARD)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  wishlistItems WishlistItem[]

  @@index([userId])
  @@schema("app")
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  itemId     String
  quantity   Int      @default(1)
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, itemId])
  @@schema("app")
}

model ExchangeMember {
  id                     String         @id @default(uuid())
  exchangeId             String
  userId                 String
  /// Mission-assigned at join, drawn from `CODENAME_POOL` (`src/lib/codename.ts`). Unique per mission.
  codename               String?
  /// When the agent accepted their codename. Rerolls stop once set.
  codenameAcceptedAt     DateTime?
  role                   MemberRole     @default(MEMBER)
  targetUserId           String?
  shippingStatus         ShippingStatus @default(PENDING)
  trackingNumber         String?
  shippedAt              DateTime?
  deliveredConfirmed     Boolean        @default(false)
  propertyWaiverAgreedAt DateTime?
  dropProofPhotoUrl      String?
  dropProofNote          String?
  droppedAt              DateTime?
  targetGuessName        String?
  targetGuessAttempted   Boolean        @default(false)
  targetGuessCorrect     Boolean?
  detectionStatus        String         @default("PENDING") // PENDING | UNDETECTED | BUSTED
  bustedPhotoUrl         String?
  bustedReason           String?
  badgeAwarded           String? // KOVERT_KLAUS | VIGILANT_ELF
  joinedAt               DateTime       @default(now())

  exchange   Exchange  @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  user       User      @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  targetUser User?     @relation("TargetUser", fields: [targetUserId], references: [id])
  wishlist   Wishlist?

  @@unique([exchangeId, userId])
  @@unique([exchangeId, codename])
  @@index([exchangeId])
  @@index([userId])
  @@index([targetUserId])
  @@schema("app")
}

model CovertInviteToken {
  id           String   @id @default(uuid())
  exchangeId   String
  exchange     Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  token        String   @unique
  invitedEmail String?
  invitedName  String?
  isUsed       Boolean  @default(false)
  usedByUserId String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([exchangeId])
  @@index([token])
  @@schema("app")
}

/// Lifecycle of an emailed mission invitation.
enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED

  @@schema("app")
}

/// An email invitation from the Head Elf to join a mission. Matched to users by email.
/// Pending invites expire after the invite cutoff unless issued as a Late Pass.
model MissionInvitation {
  id          String           @id @default(uuid())
  exchangeId  String
  email       String
  invitedById String
  /// Set when the invitee enrolls.
  userId      String?
  status      InvitationStatus @default(PENDING)
  /// Issued after the invite cutoff to an already registered user.
  isLatePass  Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  respondedAt DateTime?

  exchange  Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  invitedBy User     @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([exchangeId, email])
  @@index([email, status])
  @@schema("app")
}

model ExclusionRule {
  id                 String @id @default(uuid())
  exchangeId         String
  memberId           String
  restrictedMemberId String

  exchange         Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  member           User     @relation("ExclusionMember", fields: [memberId], references: [id], onDelete: Cascade)
  restrictedMember User     @relation("ExclusionRestrictedMember", fields: [restrictedMemberId], references: [id], onDelete: Cascade)

  @@unique([exchangeId, memberId, restrictedMemberId])
  @@schema("app")
}

/// Which conversation a mission message belongs to.
enum MessageChannel {
  /// Head Elf <-> one agent: operational questions and nudges. Sending closes at completion.
  COMMAND
  /// Secret Santa <-> target, Santa anonymous. From the draw until completion.
  INTEL
  /// One agent -> the whole mission, after completion. Readable for 14 days.
  DEBRIEF

  @@schema("app")
}

model ExchangeMessage {
  id          String         @id @default(uuid())
  exchangeId  String
  channel     MessageChannel @default(INTEL)
  senderId    String
  /// Null for a DEBRIEF message to the whole mission.
  recipientId String?
  messageText String
  /// INTEL only: true when the Santa wrote it (giver to target).
  isFromSanta Boolean        @default(true)
  createdAt   DateTime       @default(now())

  exchange  Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  sender    User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User?    @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([exchangeId])
  @@index([exchangeId, channel, createdAt])
  @@schema("app")
}

model Notification {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  message        String
  exchangeId     String?
  isAcknowledged Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([userId, isAcknowledged])
  @@schema("app")
}

model ExchangeReport {
  id           String   @id @default(uuid())
  exchangeId   String
  userId       String
  thankYouText String?
  photoUrl     String?
  createdAt    DateTime @default(now())

  exchange Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([exchangeId])
  @@schema("app")
}

model ClearanceLead {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  ipHash    String?
  source    String   @default("landing_waitlist")
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("app")
}

model AdminUser {
  id                    String    @id @default(uuid())
  email                 String    @unique
  username              String?   @unique
  name                  String
  passwordHash          String
  role                  String    @default("SUPER_ADMIN") // "SUPER_ADMIN" | "OPS_ADMIN" | "MODERATOR"
  isActive              Boolean   @default(true)
  requiresPasswordReset Boolean   @default(false)
  lastLoginAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@schema("admin")
}

model ThemePreset {
  id         String  @id // e.g. "winter_holiday", "spring_egg_hunt", "tropic_klaus", "spooky_autumn"
  name       String // Display Name e.g. "Winter Holiday (Klaus & Kovert)"
  season     String  @default("winter") // "winter" | "spring" | "summer" | "autumn" | "universal"
  isDefault  Boolean @default(false)
  altHomeKey String? @default("coming_soon") // Linked ALT_HOME component key

  // Seasonal Themed Banner Text
  bannerTextLight String? @default("🎄 Welcome to KovertKlaus! Organize gift exchanges in under 60 seconds.")
  bannerTextDark  String? @default("❄️ Winter Night Ops Active — Covert Holiday Gifting")

  // Visual Strand Style
  lightsStrandType String @default("christmas_bulbs") // "christmas_bulbs" | "easter_eggs" | "tropic_lanterns" | "spooky_pumpkins" | "none"

  // Dual Design System Token Overrides (JSON Objects)
  lightTokens Json? // CSS classes for Light Mode (pageBg, headerBg, btnPrimary, badgeCode, etc.)
  darkTokens  Json? // CSS classes for Dark Mode

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  systemConfigs SystemConfig[]

  @@schema("app")
}

model SystemConfig {
  id                       String      @id @default("singleton")
  activeThemeId            String      @default("winter_holiday")
  activeTheme              ThemePreset @relation(fields: [activeThemeId], references: [id])
  activeSeason             String      @default("auto") // "auto" | "winter" | "spring" | "summer" | "autumn"
  announcementBannerActive Boolean     @default(true)
  maintenanceMode          Boolean     @default(false)
  maintenanceMessage       String?

  // Dynamic App & Routing Options (administered via /northpole)
  altHome String? @default("")
  appMode String  @default("selfhosted") // "selfhosted" | "saas"

  // Universal Transactional Email Settings (administered via /northpole)
  emailProvider    String  @default("auto") // "auto" | "brevo" | "smtp" | "resend" | "console"
  emailFrom        String  @default("admin@kovertklaus.com")
  emailFromName    String  @default("KovertKlaus HQ")
  brevoApiKey      String?
  brevoSenderEmail String?
  brevoSenderName  String?
  smtpHost         String?
  smtpPort         Int?    @default(587)
  smtpUser         String?
  smtpPass         String?
  smtpSecure       Boolean @default(false)
  smtpFrom         String?
  resendApiKey     String?

  // Public Limits & Quotas
  freeAnnualHostAllowance Int     @default(1)
  freeAnnualJoinAllowance Int     @default(3)
  paidEventPriceUsd       Decimal @default(5.00) @db.Decimal(10, 2)
  maxFreeParticipants     Int     @default(25)
  maxWishlistItems        Int     @default(50)
  defaultBudgetMin        Decimal @default(0.00) @db.Decimal(10, 2)
  defaultBudgetMax        Decimal @default(50.00) @db.Decimal(10, 2)
  defaultCurrency         String  @default("USD")

  // Automated Mission Lifecycle Scheduler (administered via /northpole)
  lifecycleCronEnabled         Boolean   @default(true)
  lifecycleCronIntervalMinutes Int       @default(60)
  lastLifecycleRunAt           DateTime?
  lastLifecycleTransitions     Int?      @default(0)

  updatedAt        DateTime @updatedAt
  updatedByAdminId String?

  @@schema("admin")
}

model SystemLog {
  id         String   @id @default(uuid())
  level      LogLevel @default(INFO)
  category   String // "EMAIL" | "AUTH" | "DB" | "SCRAPER" | "WORKER" | "OPERATION" | "ADMIN"
  message    String   @db.Text
  metadata   Json? // Structured JSON payload (sanitized & size-capped at 2KB)
  path       String? // Request pathname (e.g. "/api/leads", "/api/operations")
  method     String? // HTTP method ("POST", "GET", "PATCH", "DELETE")
  statusCode Int? // HTTP status code (e.g. 500, 400, 429)
  ip         String? // Client IP (if available)
  userAgent  String? // Client user-agent string
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([level, createdAt])
  @@index([category, createdAt])
  @@schema("admin")
}

model PreLaunchApproval {
  id         String   @id @default(uuid())
  email      String   @unique
  inviteCode String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@schema("app")
}
